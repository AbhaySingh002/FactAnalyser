# Database (Local Docker or Render Managed Postgres)
DATABASE_URL=postgresql://postgres:password@localhost:5432/factlayer

# AI Provider API Keys
GROQ_API_KEY=
GEMINI_API_KEY=
OPENROUTER_API_KEY=

# ── Multi-Model Fallback Chains (Unified Gateway) ──────────────────────
CHAT_MODELS=openai/gpt-4o-mini:free,amazon/nova-2-lite-v1:free,openrouter/free,google/gemma-4-31b-it:free,nvidia/nemotron-3.5-lightning:free,qwen/qwen3.8-27b,openai/gpt-oss-20b,gemini-3.6-flash
VISION_MODELS=openai/gpt-4o-mini:free,amazon/nova-2-lite-v1:free,openrouter/free,nex-agi/nex-n2.5-pro:free,google/gemma-4-31b-it:free,gemini-3.6-flash,openai/gpt-oss-20b
EXTRACTION_MODELS=openai/gpt-4o-mini:free,amazon/nova-2-lite-v1:free,openrouter/free,google/gemma-4-31b-it:free,gemini-3.6-flash,openai/gpt-oss-20b


OCR_PROVIDER=gemini
GEMINI_VISION_MODEL=gemini-3.6-flash
EXTRACTION_MODEL=gemini-3.6-flash
EMBEDDING_MODEL=gemini-embedding-001
CHAT_MODEL=qwen/qwen3.8-27b
GEMINI_CHAT_MODEL=gemini-3.6-flash

# Rate Limiting (7-second sleep ensures safe RPM under quota limits)
RATE_LIMIT_SLEEP_SECONDS=7.0
GEMINI_MIN_INTERVAL=7.0
CHAT_SLEEP_SECONDS=0.0

# Storage (R2 S3-compatible; falls back automatically to local scratch/storage if empty)
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=
R2_PUBLIC_URL=

# Server & CORS
FRONTEND_ORIGIN=*
PORT=8000

# Authentication (Clerk)
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_test_...
CLERK_SECRET_KEY=sk_test_...
NEXT_PUBLIC_CLERK_SIGN_IN_URL=/sign-in
NEXT_PUBLIC_CLERK_SIGN_UP_URL=/sign-up
NEXT_PUBLIC_CLERK_AFTER_SIGN_IN_URL=/app
NEXT_PUBLIC_CLERK_AFTER_SIGN_UP_URL=/app
